@@ -0,0 +1,711 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Server-side maximum connection age for the gRPC receivers.
+//!
+//! gRPC clients keep a connection for as long as it works, and most of them
+//! re-resolve their target only when a connection closes. Behind a DNS name
+//! that fans out to several receivers (a Kubernetes headless Service), a
+//! receiver added later therefore gets no traffic until something breaks the
+//! existing connections. The usual fix, `MAX_CONNECTION_AGE` in grpc-go and
+//! grpc-java, is for the server to close every connection after a while:
+//!
+//! - at `max_connection_age` (jittered by +/-10% per connection, so that
+//!   connections opened together do not all reconnect together) the server
+//!   sends an HTTP/2 GOAWAY. The client stops starting RPCs on the connection,
+//!   opens a new one (re-resolving its target) and lets the in-flight RPCs
+//!   finish; the connection closes when the last one has.
+//! - if RPCs are still running `max_connection_age_grace` after the GOAWAY,
+//!   the connection is closed and they fail (retryably, `UNAVAILABLE`).
+//!   Such an RPC may have been processed already, so the client's resend can
+//!   duplicate it: keep the grace above the server's RPC timeout, so that
+//!   every RPC in flight at the GOAWAY gets its response first.
+//!
+//! tonic 0.14 has `Server::max_connection_age`, but it cannot be used: its
+//! age is the same for every connection, with a grace set it never sends the
+//! GOAWAY (it drops the connection at age + grace), and without one it polls
+//! its finished timer again, which panics the connection's task (killing its
+//! in-flight RPCs) whenever the connection is busy at that moment. So each
+//! accepted connection here is served by its own clone of the tonic
+//! [`Server`], whose shutdown signal fires at the connection's jittered age:
+//! tonic then shuts that one connection down gracefully (GOAWAY, wait for the
+//! in-flight RPCs), exactly as it does for a server shutdown. The grace is
+//! enforced below tonic, on the connection's I/O ([`AgedIo`]), which fails
+//! reads and writes once it has passed. Everything else (layers, HTTP/2
+//! settings, connection info) is tonic's own code path.
+//!
+//! With no `max_connection_age` configured the listener is served exactly as
+//! before, by one tonic server.
+
+use futures::stream::{self, FuturesUnordered};
+use futures::{Stream, StreamExt};
+use otel_arrow_dfe_telemetry::{otel_debug, otel_warn};
+use std::future::Future;
+use std::hash::{BuildHasher, Hasher, RandomState};
+use std::io;
+use std::pin::{Pin, pin};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::task::{Context, Poll};
+use std::time::Duration;
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+use tokio::sync::oneshot;
+use tokio::time::Sleep;
+use tokio_util::sync::CancellationToken;
+use tonic::body::Body;
+use tonic::codegen::{Body as HttpBody, Bytes, Service, StdError};
+use tonic::service::Routes;
+use tonic::transport::Server;
+use tonic::transport::server::Connected;
+use tower::Layer;
+
+/// The spread applied to `max_connection_age`: each connection's age is drawn
+/// uniformly from `[age * (1 - JITTER), age * (1 + JITTER)]` (grpc-go's +/-10%).
+pub const MAX_CONNECTION_AGE_JITTER: f64 = 0.1;
+
+/// What happened to a connection because of its age, for the receiver's
+/// metrics.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ConnectionAgeEvent {
+    /// The connection reached its age and was sent a GOAWAY.
+    GoAway,
+    /// The connection was still open when the grace ran out and was closed.
+    /// RPCs still in flight failed without a response: the client does not
+    /// know whether they were processed, and resends them.
+    ForceClosed,
+}
+
+/// Called on every [`ConnectionAgeEvent`].
+pub type ConnectionAgeObserver = Arc<dyn Fn(ConnectionAgeEvent) + Send + Sync>;
+
+/// A validated `max_connection_age` / `max_connection_age_grace` pair.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ConnectionAge {
+    /// Nominal age after which a connection is sent a GOAWAY.
+    pub max_age: Duration,
+    /// How long in-flight RPCs may run after the GOAWAY before the connection
+    /// is closed under them. `None`: as long as they take.
+    pub grace: Option<Duration>,
+}
+
+impl ConnectionAge {
+    /// Builds the setting from the two optional config values. `Ok(None)` when
+    /// neither is set (the feature is off).
+    ///
+    /// # Errors
+    /// When the grace is set without an age, or the age is zero.
+    pub fn from_settings(
+        max_age: Option<Duration>,
+        grace: Option<Duration>,
+    ) -> Result<Option<Self>, String> {
+        match (max_age, grace) {
+            (None, None) => Ok(None),
+            (None, Some(_)) => Err(
+                "`max_connection_age_grace` has no effect without `max_connection_age`".to_string(),
+            ),
+            (Some(age), _) if age.is_zero() => {
+                Err("`max_connection_age` must be greater than zero".to_string())
+            }
+            (Some(max_age), grace) => Ok(Some(Self { max_age, grace })),
+        }
+    }
+
+    /// A per-connection age: `max_age` scaled by a uniformly random factor in
+    /// `[1 - JITTER, 1 + JITTER)`.
+    #[must_use]
+    pub fn jittered_age(&self) -> Duration {
+        self.jittered_with(random_unit())
+    }
+
+    /// The age for `unit` in `[0, 1)`: `0` gives the shortest, `1` the longest.
+    #[must_use]
+    pub fn jittered_with(&self, unit: f64) -> Duration {
+        let unit = unit.clamp(0.0, 1.0);
+        let factor = 1.0 - MAX_CONNECTION_AGE_JITTER + 2.0 * MAX_CONNECTION_AGE_JITTER * unit;
+        self.max_age.mul_f64(factor)
+    }
+}
+
+/// A uniform value in `[0, 1)`, from std's randomly keyed SipHash (no extra
+/// dependency; this only has to decorrelate connections, not be secure).
+fn random_unit() -> f64 {
+    static COUNTER: AtomicU64 = AtomicU64::new(0);
+    let mut hasher = RandomState::new().build_hasher();
+    hasher.write_u64(COUNTER.fetch_add(1, Ordering::Relaxed));
+    (hasher.finish() >> 11) as f64 / (1u64 << 53) as f64
+}
+
+/// A connection's I/O with a hard deadline: once it has passed, every read and
+/// write fails with `TimedOut`, which makes hyper drop the connection. It also
+/// signals its own drop, which is how the per-connection server learns that
+/// the connection is gone.
+pub struct AgedIo<IO> {
+    inner: IO,
+    deadline: Option<Pin<Box<Sleep>>>,
+    expired: bool,
+    observer: Option<ConnectionAgeObserver>,
+    _closed: oneshot::Sender<()>,
+}
+
+impl<IO> AgedIo<IO> {
+    /// Wraps `inner`. `close_after`: when to force the connection closed.
+    /// The receiver resolves when the returned value is dropped.
+    pub fn new(
+        inner: IO,
+        close_after: Option<Duration>,
+        observer: Option<ConnectionAgeObserver>,
+    ) -> (Self, oneshot::Receiver<()>) {
+        let (tx, rx) = oneshot::channel();
+        (
+            Self {
+                inner,
+                deadline: close_after.map(|d| Box::pin(tokio::time::sleep(d))),
+                expired: false,
+                observer,
+                _closed: tx,
+            },
+            rx,
+        )
+    }
+
+    fn check_deadline(&mut self, cx: &mut Context<'_>) -> io::Result<()> {
+        if !self.expired
+            && let Some(deadline) = self.deadline.as_mut()
+            && deadline.as_mut().poll(cx).is_ready()
+        {
+            self.expired = true;
+            otel_warn!(
+                "grpc.server.connection_age.force_close",
+                message = "max_connection_age_grace ran out before the connection closed; closing it (RPCs still in flight fail)"
+            );
+            if let Some(observer) = &self.observer {
+                observer(ConnectionAgeEvent::ForceClosed);
+            }
+        }
+        if self.expired {
+            Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "max_connection_age_grace elapsed",
+            ))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl<IO: AsyncRead + Unpin> AsyncRead for AgedIo<IO> {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        if let Err(e) = this.check_deadline(cx) {
+            return Poll::Ready(Err(e));
+        }
+        Pin::new(&mut this.inner).poll_read(cx, buf)
+    }
+}
+
+impl<IO: AsyncWrite + Unpin> AsyncWrite for AgedIo<IO> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        if let Err(e) = this.check_deadline(cx) {
+            return Poll::Ready(Err(e));
+        }
+        Pin::new(&mut this.inner).poll_write(cx, buf)
+    }
+
+    fn poll_write_vectored(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        bufs: &[io::IoSlice<'_>],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        if let Err(e) = this.check_deadline(cx) {
+            return Poll::Ready(Err(e));
+        }
+        Pin::new(&mut this.inner).poll_write_vectored(cx, bufs)
+    }
+
+    fn is_write_vectored(&self) -> bool {
+        self.inner.is_write_vectored()
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        if let Err(e) = this.check_deadline(cx) {
+            return Poll::Ready(Err(e));
+        }
+        Pin::new(&mut this.inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(cx)
+    }
+}
+
+impl<IO: Connected> Connected for AgedIo<IO> {
+    type ConnectInfo = IO::ConnectInfo;
+
+    fn connect_info(&self) -> Self::ConnectInfo {
+        self.inner.connect_info()
+    }
+}
+
+/// Serves `routes` on `incoming` like tonic's
+/// `server.add_routes(routes).serve_with_incoming_shutdown(incoming, signal)`,
+/// adding the connection age when `age` is set (see the module docs).
+/// `observer` is told about every GOAWAY and forced close.
+///
+/// On `signal` it stops accepting, asks every connection to shut down
+/// gracefully and returns once they have all closed, as tonic does.
+///
+/// # Errors
+/// Whatever tonic's serve returns.
+pub async fn serve_with_connection_age<L, I, IO, IE, F, ResBody>(
+    server: Server<L>,
+    routes: Routes,
+    incoming: I,
+    signal: F,
+    age: Option<ConnectionAge>,
+    observer: Option<ConnectionAgeObserver>,
+) -> Result<(), tonic::transport::Error>
+where
+    L: Layer<Routes> + Clone,
+    L::Service:
+        Service<http::Request<Body>, Response = http::Response<ResBody>> + Clone + Send + 'static,
+    <L::Service as Service<http::Request<Body>>>::Future: Send,
+    <L::Service as Service<http::Request<Body>>>::Error: Into<StdError> + Send,
+    I: Stream<Item = Result<IO, IE>>,
+    IO: AsyncRead + AsyncWrite + Connected + Unpin + Send + 'static,
+    IE: Into<StdError>,
+    F: Future<Output = ()>,
+    ResBody: HttpBody<Data = Bytes> + Send + 'static,
+    ResBody::Error: Into<StdError>,
+{
+    let routes = routes.prepare();
+    let Some(age) = age else {
+        return server
+            .serve_with_incoming_shutdown(routes, incoming, signal)
+            .await;
+    };
+
+    let shutdown = CancellationToken::new();
+    let mut connections = FuturesUnordered::new();
+    let mut incoming = pin!(incoming);
+    let mut signal = pin!(signal);
+    let mut result = Ok(());
+
+    loop {
+        tokio::select! {
+            () = &mut signal => break,
+            Some(served) = connections.next() => {
+                if let Err(e) = served {
+                    result = Err(e);
+                    break;
+                }
+            }
+            accepted = incoming.next() => match accepted {
+                None => break,
+                // tonic skips failed accepts (and failed TLS handshakes) too.
+                Some(Err(_)) => continue,
+                Some(Ok(io)) => {
+                    let conn_age = age.jittered_age();
+                    let (io, closed) =
+                        AgedIo::new(io, age.grace.map(|g| conn_age + g), observer.clone());
+                    // One connection, then end the stream when it closes so
+                    // that its server returns; until then, keep it open
+                    // (tonic shuts connections down when `incoming` ends).
+                    let one = stream::once(async move { Ok::<_, IE>(io) }).chain(
+                        stream::once(closed).filter_map(|_| async { None }),
+                    );
+                    // This connection's server shuts it down gracefully (a
+                    // GOAWAY) at its age, or with everything else.
+                    let shutdown = shutdown.clone();
+                    let observer = observer.clone();
+                    let aged = async move {
+                        tokio::select! {
+                            () = shutdown.cancelled() => {}
+                            () = tokio::time::sleep(conn_age) => {
+                                otel_debug!(
+                                    "grpc.server.connection_age.goaway",
+                                    age_ms = conn_age.as_millis() as u64
+                                );
+                                if let Some(observer) = &observer {
+                                    observer(ConnectionAgeEvent::GoAway);
+                                }
+                            }
+                        }
+                    };
+                    connections.push(server.clone().serve_with_incoming_shutdown(
+                        routes.clone(),
+                        one,
+                        aged,
+                    ));
+                }
+            }
+        }
+    }
+
+    shutdown.cancel();
+    while let Some(served) = connections.next().await {
+        if result.is_ok() {
+            result = served;
+        }
+    }
+    result
+}
