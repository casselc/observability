+describe('otelBasisHeaders (D30)', () => {
+  it('forwards a well-formed basis and basis group', () => {
+    expect(
+      otelBasisHeaders({
+        'x-otel-basis': 'b1.eyJ2IjoxfQ.mac-_1',
+        'x-otel-basis-group': 'abcd1234-1000-2000',
+      }),
+    ).toEqual({
+      'x-otel-basis': 'b1.eyJ2IjoxfQ.mac-_1',
+      'x-otel-basis-group': 'abcd1234-1000-2000',
+    });
+    expect(otelBasisHeaders({ 'x-otel-basis': 'latest' })).toEqual({
+      'x-otel-basis': 'latest',
+    });
+  });
+
+  it('drops anything else', () => {
+    for (const v of ['', 'b1.a', 'b2.a.b', 'b1.a.b\r\nX-Evil: 1', 'b1.a b.c']) {
+      expect(otelBasisHeaders({ 'x-otel-basis': v })).toEqual({});
+    }
+    for (const v of ['short', 'g'.repeat(65), 'abcd1234;x']) {
+      expect(otelBasisHeaders({ 'x-otel-basis-group': v })).toEqual({});
+    }
+    expect(
