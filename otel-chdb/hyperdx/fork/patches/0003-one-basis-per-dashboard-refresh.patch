+const GROUP_RE = /^[A-Za-z0-9_-]{8,64}$/;
+
+function nonce(): string {
+  const c = (globalThis as { crypto?: { randomUUID?: () => string } }).crypto;
+  const id =
+    c?.randomUUID?.() ??
