+        }
+    }
+
+    /// Serves `SlowLogs` with the receivers' tuning for these settings; the
+    /// token stops it.
+    async fn serve(
+        max_age: Option<Duration>,
+        grace: Option<Duration>,
+        delay: Duration,
+    ) -> (SocketAddr, CancellationToken) {
+        let settings = GrpcServerSettings {
+            max_concurrent_requests: 16,
+            max_connection_age: max_age,
+            max_connection_age_grace: grace,
+            ..Default::default()
+        };
+        settings.validate_connection_age().unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let stop = CancellationToken::new();
+        let signal = stop.clone();
+        drop(tokio::spawn(
+            apply_server_tuning(Server::builder(), &settings)
+                .add_service(LogsServiceServer::new(SlowLogs { delay }))
+                .serve_with_incoming_shutdown(TcpIncoming::from(listener), async move {
+                    signal.cancelled().await;
+                }),
+        ));
+        (addr, stop)
+    }
+
+    fn secs(s: f64) -> Duration {
+        Duration::from_secs_f64(s)
+    }
+
+    /// Reads one HTTP/2 frame: (type, flags, payload).
+    async fn read_frame(tcp: &mut TcpStream) -> Option<(u8, u8, Vec<u8>)> {
+        let mut head = [0u8; 9];
+        let _ = tcp.read_exact(&mut head).await.ok()?;
+        let len = usize::from(head[0]) << 16 | usize::from(head[1]) << 8 | usize::from(head[2]);
+        let mut payload = vec![0u8; len];
+        let _ = tcp.read_exact(&mut payload).await.ok()?;
+        Some((head[3], head[4], payload))
+    }
+
+    async fn write_frame(tcp: &mut TcpStream, kind: u8, flags: u8, payload: &[u8]) {
+        let len = payload.len();
+        let mut frame = vec![(len >> 16) as u8, (len >> 8) as u8, len as u8, kind, flags];
+        frame.extend_from_slice(&[0, 0, 0, 0]);
+        frame.extend_from_slice(payload);
+        tcp.write_all(&frame).await.unwrap();
+    }
+
+    /// Opens a raw HTTP/2 connection and answers SETTINGS and PINGs until the
+    /// server closes it or `watch` runs out. Returns every GOAWAY seen as
+    /// (time since connecting, last stream id, error code).
+    async fn goaways(addr: SocketAddr, watch: Duration) -> Vec<(Duration, u32, u32)> {
+        const SETTINGS: u8 = 0x4;
+        const PING: u8 = 0x6;
+        const GOAWAY: u8 = 0x7;
+        let started = Instant::now();
+        let mut tcp = TcpStream::connect(addr).await.unwrap();
+        tcp.write_all(b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
+            .await
+            .unwrap();
+        write_frame(&mut tcp, SETTINGS, 0, &[]).await;
+        let mut goaways = Vec::new();
+        while let Ok(Some((kind, flags, payload))) = tokio::time::timeout(
+            watch.saturating_sub(started.elapsed()),
+            read_frame(&mut tcp),
+        )
+        .await
+        {
+            match kind {
+                SETTINGS if flags & 1 == 0 => write_frame(&mut tcp, SETTINGS, 1, &[]).await,
+                PING if flags & 1 == 0 => write_frame(&mut tcp, PING, 1, &payload).await,
+                GOAWAY => {
+                    let last = u32::from_be_bytes(payload[0..4].try_into().unwrap()) & 0x7fff_ffff;
+                    let code = u32::from_be_bytes(payload[4..8].try_into().unwrap());
+                    goaways.push((started.elapsed(), last, code));
+                }
+                _ => {}
+            }
+        }
+        goaways
+    }
+
+    /// Scenario: an idle raw HTTP/2 client on a receiver server with a 1 s
+    /// `max_connection_age`, with and without a grace; and with no age.
+    /// Guarantees: the settings reach tonic: at 0.9-1.1 s the server sends the
+    /// graceful two-step GOAWAY (last stream id 2^31-1, then the real one,
+    /// both NO_ERROR) and closes the connection; with no age, nothing is sent.
+    #[tokio::test]
+    async fn connection_age_sends_two_step_goaway() {
+        for grace in [Some(secs(5.0)), None] {
+            let (addr, stop) = serve(Some(secs(1.0)), grace, Duration::ZERO).await;
+            let seen = goaways(addr, secs(4.0)).await;
+            assert_eq!(seen.len(), 2, "grace {grace:?}: GOAWAY frames {seen:?}");
+            let (first_at, first_last, first_code) = seen[0];
+            assert!(
+                first_at >= secs(0.85) && first_at < secs(1.6),
+                "grace {grace:?}: first GOAWAY after {first_at:?}"
+            );
+            assert_eq!((first_last, first_code), (0x7fff_ffff, 0));
+            assert_eq!((seen[1].1, seen[1].2), (0, 0));
+            stop.cancel();
+        }
+        let (addr, stop) = serve(None, None, Duration::ZERO).await;
+        assert_eq!(goaways(addr, secs(1.5)).await, Vec::new());
+        stop.cancel();
+    }
+
+    /// Scenario: RPCs on a connection that reaches its 1 s age: one taking
+    /// 1.5 s, started at 0.5 s, with a 3 s grace; one taking 10 s with a 1 s
+    /// grace.
+    /// Guarantees: the first completes normally after the GOAWAY; the second
+    /// is cut at age + grace (1.8-2.8 s) instead of running on.
+    #[tokio::test]
+    async fn connection_age_grace_bounds_in_flight_rpcs() {
+        let (addr, stop) = serve(Some(secs(1.0)), Some(secs(3.0)), secs(1.5)).await;
+        let mut client = LogsServiceClient::connect(format!("http://{addr}"))
+            .await
+            .unwrap();
+        tokio::time::sleep(secs(0.5)).await;
+        let rpc = client.export(ExportLogsServiceRequest::default()).await;
+        assert!(rpc.is_ok(), "in-flight RPC failed: {rpc:?}");
+        stop.cancel();
+
+        let (addr, stop) = serve(Some(secs(1.0)), Some(secs(1.0)), secs(10.0)).await;
+        let mut client = LogsServiceClient::connect(format!("http://{addr}"))
+            .await
+            .unwrap();
+        let started = Instant::now();
+        let rpc = client.export(ExportLogsServiceRequest::default()).await;
+        let cut_at = started.elapsed();
+        assert!(rpc.is_err(), "the RPC outlived age + grace");
+        assert!(
+            cut_at >= secs(1.8) && cut_at < secs(2.8),
+            "cut after {cut_at:?}"
+        );
+        stop.cancel();
+    }
+}
