+
+describe('processClickhouseSettings - no partial results (core/overflow.ts)', () => {
+  const run = async (
+    settings: Record<string, any>,
+    allowSampledRead?: boolean,
+  ) => {
+    const client = new ClickhouseClient({
+      host: 'http://localhost:8123',
+      username: 'default',
+      password: '',
+    });
+    const query = jest.fn(async ({ clickhouse_settings }: any) => ({
+      json: async () => ({ data: [], clickhouse_settings }),
+    }));
+    (client as any).client = { query };
+    await client.query({
+      query: 'SELECT 1',
+      format: 'JSON',
+      clickhouse_settings: settings,
+      allowSampledRead,
+    });
+    return query.mock.calls[0][0].clickhouse_settings;
+  };
+
+  beforeEach(() => {
+    jest.spyOn(console, 'debug').mockImplementation(() => {});
+    jest.spyOn(console, 'info').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it("pins every overflow mode to throw over the caller's settings", async () => {
+    const s = await run({
+      timeout_overflow_mode: 'break',
+      read_overflow_mode: 'break',
+      group_by_overflow_mode: 'any',
+      result_overflow_mode: 'break',
+      max_execution_time: '15',
+    });
+    expect(s).toMatchObject(NO_PARTIAL_RESULTS);
+    expect(s.max_execution_time).toBe('15');
+  });
+
+  it('lets only a read sample through with allowSampledRead', async () => {
+    const s = await run(
+      { read_overflow_mode: 'break', timeout_overflow_mode: 'break' },
+      true,
+    );
+    expect(s.read_overflow_mode).toBe('break');
+    expect(s.timeout_overflow_mode).toBe('throw');
+    expect(s.group_by_overflow_mode).toBe('throw');
+    const plain = await run({}, true);
+    expect(plain.read_overflow_mode).toBe('throw');
+  });
+});
