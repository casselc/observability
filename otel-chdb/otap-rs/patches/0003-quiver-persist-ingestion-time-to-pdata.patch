+        let dir = tempdir().expect("tempdir");
+        let config = QuiverConfig::builder()
+            .data_dir(dir.path())
+            .segment(SegmentConfig {
+                target_size_bytes: NonZeroU64::new(100 * 1024 * 1024).unwrap(),
+                max_open_duration: Duration::from_secs(3600),
+                ..Default::default()
+            })
+            .build()
+            .expect("config");
+        let day_ago = SystemTime::now() - Duration::from_secs(86_400);
+        let times: Vec<i64> = (0..3)
+            .map(|i| {
+                let t = day_ago + Duration::from_millis(i);
+                i64::try_from(t.duration_since(UNIX_EPOCH).unwrap().as_nanos()).unwrap()
