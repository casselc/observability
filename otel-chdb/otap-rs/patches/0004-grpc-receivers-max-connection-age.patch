+    type RawChannel = tower::util::BoxCloneService<
+        http::Request<Body>,
+        http::Response<hyper::body::Incoming>,
+        hyper::Error,
+    >;
+
+    /// One raw HTTP/2 connection (no reconnects, unlike a tonic `Channel`).
+    /// Returns a gRPC client on it and a handle that resolves, with the time
+    /// since connecting, once the client has dropped the TCP connection.
+    async fn connect(
+        addr: std::net::SocketAddr,
+    ) -> (
+        LogsServiceClient<RawChannel>,
+        tokio::task::JoinHandle<Duration>,
+    ) {
+        let started = Instant::now();
+        let tcp = TcpStream::connect(addr).await.unwrap();
+        let (tcp, dropped) = AgedIo::new(tcp, None, None);
+        let (send, conn) = hyper::client::conn::http2::handshake(
+            hyper_util::rt::TokioExecutor::new(),
+            hyper_util::rt::TokioIo::new(tcp),
+        )
+        .await
+        .unwrap();
+        drop(tokio::spawn(conn));
+        let closed = tokio::spawn(async move {
+            let _ = dropped.await;
+            started.elapsed()
+        });
+        let channel = RawChannel::new(tower::service_fn(move |req| {
+            let mut send = send.clone();
+            async move { send.send_request(req).await }
+        }));
+        let client = LogsServiceClient::with_origin(channel, "http://127.0.0.1".parse().unwrap());
+        (client, closed)
+    }
+
+    fn secs(s: f64) -> Duration {
+        Duration::from_secs_f64(s)
+    }
+
+    /// Reads one HTTP/2 frame: (type, flags, payload).
+    async fn read_frame(tcp: &mut TcpStream) -> Option<(u8, u8, Vec<u8>)> {
+        let mut head = [0u8; 9];
+        let _ = tcp.read_exact(&mut head).await.ok()?;
+        let len = usize::from(head[0]) << 16 | usize::from(head[1]) << 8 | usize::from(head[2]);
+        let mut payload = vec![0u8; len];
+        let _ = tcp.read_exact(&mut payload).await.ok()?;
+        Some((head[3], head[4], payload))
+    }
+
+    async fn write_frame(tcp: &mut TcpStream, kind: u8, flags: u8, payload: &[u8]) {
+        let len = payload.len();
+        let mut frame = vec![(len >> 16) as u8, (len >> 8) as u8, len as u8, kind, flags];
+        frame.extend_from_slice(&[0, 0, 0, 0]);
+        frame.extend_from_slice(payload);
+        tcp.write_all(&frame).await.unwrap();
+    }
+
+    /// Scenario: an idle HTTP/2 client, speaking raw frames, on a server with
+    /// a 1 s max age.
+    /// Guarantees: at 0.9-1.1 s the server sends the RFC 9113 graceful
+    /// sequence -- a GOAWAY with last-stream-id 2^31-1 and a PING, then, after
+    /// the PING ack, a second GOAWAY with the real last stream id -- and then
+    /// closes the connection.
+    #[tokio::test]
+    async fn goaway_is_two_step_at_the_jittered_age() {
+        const GOAWAY: u8 = 0x7;
+        const PING: u8 = 0x6;
+        const SETTINGS: u8 = 0x4;
+        let server = start(
+            ConnectionAge::from_settings(Some(secs(1.0)), Some(secs(5.0))).unwrap(),
+            Duration::ZERO,
+        )
+        .await;
+        let started = Instant::now();
+        let mut tcp = TcpStream::connect(server.addr).await.unwrap();
+        tcp.write_all(b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
+            .await
+            .unwrap();
+        write_frame(&mut tcp, SETTINGS, 0, &[]).await;
+        let mut goaways = Vec::new();
+        while let Some((kind, flags, payload)) = read_frame(&mut tcp).await {
+            match kind {
+                SETTINGS if flags & 1 == 0 => write_frame(&mut tcp, SETTINGS, 1, &[]).await,
+                PING if flags & 1 == 0 => write_frame(&mut tcp, PING, 1, &payload).await,
+                GOAWAY => {
+                    let last = u32::from_be_bytes(payload[0..4].try_into().unwrap()) & 0x7fff_ffff;
+                    let code = u32::from_be_bytes(payload[4..8].try_into().unwrap());
+                    goaways.push((started.elapsed(), last, code));
+                }
+                _ => {}
+            }
+        }
+        let closed = started.elapsed();
+        assert_eq!(goaways.len(), 2, "GOAWAY frames: {goaways:?}");
+        let (first_at, first_last, first_code) = goaways[0];
+        let (second_at, second_last, second_code) = goaways[1];
+        assert!(
+            first_at >= secs(0.85) && first_at < secs(1.6),
+            "first GOAWAY after {first_at:?}"
+        );
+        assert_eq!((first_last, first_code), (0x7fff_ffff, 0));
+        assert_eq!((second_last, second_code), (0, 0));
+        assert!(second_at - first_at < secs(0.5));
+        assert!(closed - second_at < secs(0.5), "closed after {closed:?}");
+        assert_eq!(server.events.get(), (1, 0));
+        server.stop().await;
+    }
+
