@@ -0,0 +1,23 @@
+import { runAsQueryServiceUser } from '@hyperdx/common-utils/dist/clickhouse/node';
+import type { NextFunction, Request, Response } from 'express';
+
+import { QUERY_SERVICE_TOKEN_HEADER } from '@/config';
+import { queryServiceToken } from '@/utils/queryServiceToken';
+
+/**
+ * otel-chdb fork: everything the API does while handling a request was
+ * started by that request's user (MCP tools, the external API, the API's
+ * own routes), so every ClickHouse query it sends carries the user's OIDC
+ * token, from the header the OIDC proxy sets (HDX_QUERY_SERVICE_TOKEN_HEADER;
+ * an MCP or external API client sends it beside its access key). The query
+ * service then scopes and audits it as that user. Without the user's
+ * token such a query fails; the service identity (HDX_QUERY_SERVICE_TOKEN_FILE)
+ * is only for work no user started: the alert task.
+ */
+export function queryServiceUser(
+  headerName: string = QUERY_SERVICE_TOKEN_HEADER,
+) {
+  return (req: Request, _res: Response, next: NextFunction) => {
+    runAsQueryServiceUser(queryServiceToken(req.headers, headerName), next);
+  };
+}
