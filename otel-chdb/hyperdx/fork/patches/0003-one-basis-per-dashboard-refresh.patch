+describe('the basis (otel-chdb fork, D30)', () => {
+  const at = (basis: string, info: string) => ({
+    completeness: 'complete' as const,
+    basis,
+    atBasis: true,
+    basisInfo: info,
+    receivedAt: 0,
+  });
+
+  it('reads which basis a result was computed at', () => {
+    const l = labelFromHeaders({
+      'x-otel-source': 'central',
+      'x-otel-completeness': 'complete',
+      'x-otel-basis': 'b1.p.m',
+      'x-otel-at-basis': 'true',
+      'x-otel-basis-info': 'prod-a<2026-09-28T12:00:00Z',
+    });
+    expect(l).toMatchObject({
+      basis: 'b1.p.m',
+      atBasis: true,
+      basisInfo: 'prod-a<2026-09-28T12:00:00Z',
+    });
+    // a basis named but not applied is not "at" it
+    expect(
+      labelFromHeaders({
+        'x-otel-source': 'central',
+        'x-otel-completeness': 'partial',
+        'x-otel-basis': 'b1.p.m',
+        'x-otel-at-basis': 'false',
+      })?.atBasis,
+    ).toBe(false);
+  });
+
+  it('counts the bases a page read at, and what read up to now', () => {
+    const one = CompletenessStore.summarize([
+      at('b1.a.m', 'x<T1'),
+      at('b1.a.m', 'x<T1'),
+    ]);
+    expect(one).toMatchObject({ bases: 1, basisInfo: 'x<T1', unpinned: 0 });
+    const two = CompletenessStore.summarize([
+      at('b1.a.m', 'x<T1'),
+      at('b1.b.m', 'x<T2'),
+      { completeness: 'partial', receivedAt: 0 },
+    ]);
+    expect(two).toMatchObject({ bases: 2, unpinned: 1 });
+    expect(two.basisInfo).toBeUndefined();
+  });
+
+  it('pins one basis group per page load and time range', () => {
+    const s = new CompletenessStore();
+    expect(s.basisHeaders()).toEqual({});
+    s.pinBasis('1000-2000');
+    const g = s.basisHeaders()['x-otel-basis-group'];
+    expect(g).toMatch(/^[A-Za-z0-9_-]{8,64}$/);
+    s.pinBasis('1000-2000'); // a re-render: the same group
+    expect(s.basisHeaders()['x-otel-basis-group']).toBe(g);
+    s.pinBasis('1000-3000'); // a refresh: a new range end
+    const g2 = s.basisHeaders()['x-otel-basis-group'];
+    expect(g2).not.toBe(g);
+    s.reset(); // a new page: nothing pinned, and the same range is a new group
+    expect(s.basisHeaders()).toEqual({});
+    s.pinBasis('1000-3000');
+    expect(s.basisHeaders()['x-otel-basis-group']).not.toBe(g2);
+    s.unpinBasis();
+    expect(s.basisHeaders()).toEqual({});
+  });
+});
+
