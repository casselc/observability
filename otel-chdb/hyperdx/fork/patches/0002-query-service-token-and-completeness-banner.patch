+import { queryServiceToken } from '@/utils/queryServiceToken';
+
+describe('queryServiceToken', () => {
+  const H = 'x-forwarded-access-token';
+
+  it('is off without a configured header', () => {
+    expect(queryServiceToken({ [H]: 'a.b.c' }, '')).toBeUndefined();
+  });
+
+  it('reads the configured header, case-insensitively', () => {
+    expect(
+      queryServiceToken({ [H]: 'a.b.c' }, 'X-Forwarded-Access-Token'),
+    ).toBe('a.b.c');
+    expect(queryServiceToken({ [H]: 'Bearer a.b.c' }, H)).toBe('a.b.c');
+  });
+
+  it('refuses what is not one token', () => {
+    for (const v of ['', 'a b', 'a.b.c, d.e.f', 'a\r\nX-Evil: 1', 'Bearer ']) {
+      expect(queryServiceToken({ [H]: v }, H)).toBeUndefined();
+    }
+    expect(
+      queryServiceToken({ [H]: ['a.b.c', 'd.e.f'] as any }, H),
+    ).toBeUndefined();
+    expect(queryServiceToken({}, H)).toBeUndefined();
+  });
+});
diff --git a/packages/api/src/utils/queryServiceToken.ts b/packages/api/src/utils/queryServiceToken.ts
new file mode 100644
index 0000000..8dba840
--- /dev/null
+++ b/packages/api/src/utils/queryServiceToken.ts
@@ -0,0 +1,21 @@
+import type { IncomingHttpHeaders } from 'http';
+
+/**
+ * otel-chdb fork: the user's OIDC token from the header the OIDC proxy in
+ * front of HyperDX sets (config.QUERY_SERVICE_TOKEN_HEADER), for the query
+ * service's adapter. Returns undefined when forwarding is off or the header
+ * is absent, empty, repeated, or not a single token.
+ */
+export function queryServiceToken(
+  headers: IncomingHttpHeaders,
+  headerName: string,
+): string | undefined {
+  if (!headerName) return undefined;
+  const raw = headers[headerName.toLowerCase()];
+  if (raw == null || Array.isArray(raw)) return undefined;
+  const token = raw.replace(/^bearer\s+/i, '').trim();
+  // a JWT is three base64url segments; anything with spaces, commas or
+  // control characters is not one token
+  if (!/^[A-Za-z0-9._~+/=-]+$/.test(token)) return undefined;
+  return token;
+}
