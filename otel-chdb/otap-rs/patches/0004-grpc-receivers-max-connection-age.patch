+
+/// Sets tonic's `max_connection_age` (a graceful GOAWAY at a per-connection
+/// age jittered by +/-10%) and `max_connection_age_grace` (the forced close
+/// after it) when configured. Check them first with [`validate_connection_age`].
+///
+/// [`validate_connection_age`]: crate::otap_grpc::server_settings::validate_connection_age
+pub fn apply_connection_age<L>(
+    mut builder: Server<L>,
+    max_age: Option<Duration>,
+    grace: Option<Duration>,
+) -> Server<L> {
+    if let Some(max_age) = max_age {
+        builder = builder.max_connection_age(max_age);
+        if let Some(grace) = grace {
+            builder = builder.max_connection_age_grace(grace);
+        }
+    }
     builder
 }
+
