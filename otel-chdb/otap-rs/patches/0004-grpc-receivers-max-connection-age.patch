+        .await;
+        let (mut client, closed) = connect(server.addr).await;
+        let rpc =
+            tokio::spawn(async move { client.export(ExportLogsServiceRequest::default()).await });
+        tokio::time::sleep(secs(0.1)).await;
+        server.stop().await;
