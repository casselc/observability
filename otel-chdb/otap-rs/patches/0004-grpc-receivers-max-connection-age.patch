+    /// Scenario: 1000 per-connection ages drawn for a 100 s max age.
+    /// Guarantees: every age is within +/-10% and they spread across the
+    /// range, so connections opened together do not all recycle together.
+    #[test]
+    fn jitter_is_within_ten_percent_and_varies() {
+        let age = ConnectionAge {
+            max_age: Duration::from_secs(100),
+            grace: None,
