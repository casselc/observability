diff --git a/packages/app/src/components/CompletenessBanner.tsx b/packages/app/src/components/CompletenessBanner.tsx
index b7d6963..b206b68 100644
--- a/packages/app/src/components/CompletenessBanner.tsx
+++ b/packages/app/src/components/CompletenessBanner.tsx
@@ -7,6 +7,40 @@ import { Alert, Text } from '@mantine/core';
 
 const fmt = (t?: string) => (t ? new Date(t).toLocaleString() : 'unknown');
 
+/**
+ * Which basis the page's results were read at (D30): one basis, pinned for
+ * this load or refresh (the panels agree, and only a refresh moves them);
+ * several (they may disagree); or results read up to now.
+ */
+export function basisMessage(s: CompletenessSummary): string {
+  if (s.worst == null || s.results === 0) return '';
+  const parts: string[] = [];
+  if (s.bases === 1) {
+    const info = s.basisInfo
+      ? ` (rows received before ${s.basisInfo
+          .split('; ')
+          .map(c => {
+            const [cluster, t] = c.split('<');
+            return cluster === '*' ? fmt(t) : `${fmt(t)} in ${cluster}`;
+          })
+          .join(', ')})`
+      : '';
+    parts.push(
+      `Pinned to one basis for this refresh${info}: the panels agree and do not change until you refresh.`,
+    );
+  } else if (s.bases > 1) {
+    parts.push(
+      `Read at ${s.bases} different bases: panels may disagree about recent data.`,
+    );
+  }
+  if (s.unpinned > 0) {
+    parts.push(
+      `${s.unpinned === 1 ? 'One result was' : `${s.unpinned} results were`} read up to now, not at a basis.`,
+    );
+  }
+  return parts.join(' ');
+}
