diff --git a/packages/app/src/components/CompletenessBanner.tsx b/packages/app/src/components/CompletenessBanner.tsx
new file mode 100644
index 0000000..b7d6963
--- /dev/null
+++ b/packages/app/src/components/CompletenessBanner.tsx
@@ -0,0 +1,79 @@
+import { useSyncExternalStore } from 'react';
+import {
+  type CompletenessSummary,
+  getCompletenessStore,
+} from '@hyperdx/common-utils/dist/clickhouse/completeness';
+import { Alert, Text } from '@mantine/core';
+
+const fmt = (t?: string) => (t ? new Date(t).toLocaleString() : 'unknown');
+
+/**
+ * The banner's text for a page's results (otel-chdb fork). Never empty when
+ * there is a result that is not complete: a partial, unknown or unlabelled
+ * result always says so.
+ */
+export function completenessMessage(s: CompletenessSummary): {
+  color: string;
+  title: string;
+  text: string;
+} | null {
+  switch (s.worst) {
+    case null:
+      return null;
+    case 'complete':
+      return {
+        color: 'gray',
+        title: `Complete through ${fmt(s.completeThrough)}`,
+        text: `Every row of the ${s.results === 1 ? 'result' : `${s.results} results`} on this page is in.`,
+      };
+    case 'partial':
+      return {
+        color: 'yellow',
+        title: 'Partial',
+        text: `Data from ${fmt(s.incompleteFrom ?? s.completeThrough)} on may still arrive (complete through ${fmt(s.completeThrough)}): counts over that range are partial.`,
+      };
+    case 'unknown':
+      return {
+        color: 'red',
+        title: `Unknown — watermark ${s.watermarkStatus ?? 'missing'}`,
+        text: `Completeness cannot be established${s.completeThrough ? ` (last known complete through ${fmt(s.completeThrough)})` : ''}: nothing on this page may be read as settled.${s.watermarkNote ? ` ${s.watermarkNote}` : ''}`,
+      };
+    case 'unlabelled':
+      return {
+        color: 'red',
+        title: 'Unknown — not labelled',
+        text: 'Some results did not come through the query service and carry no completeness label: nothing on this page may be read as settled.',
+      };
+  }
+}
+
+export function CompletenessBannerView({
+  summary,
+}: {
+  summary: CompletenessSummary;
+}) {
+  const m = completenessMessage(summary);
+  if (m == null) return null;
+  return (
+    <Alert
+      color={m.color}
+      title={m.title}
+      variant="light"
+      py={4}
+      data-testid="completeness-banner"
+      data-completeness={summary.worst}
+    >
+      <Text size="xs">{m.text}</Text>
+    </Alert>
+  );
+}
+
+export default function CompletenessBanner() {
+  const store = getCompletenessStore();
+  const summary = useSyncExternalStore(
+    store.subscribe,
+    store.getSummary,
+    store.getSummary,
+  );
+  return <CompletenessBannerView summary={summary} />;
+}
