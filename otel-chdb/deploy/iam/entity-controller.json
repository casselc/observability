{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateEntityLaneObjectsUnderOwnClusterOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET/ENTITIES/${aws:PrincipalTag/cluster}/*"
    },
    {
      "Sid": "ListOwnClusterLanes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["ENTITIES/${aws:PrincipalTag/cluster}/*", "ENTITIES/${aws:PrincipalTag/cluster}"]}}
    },
    {
      "Sid": "FreeSlotIs404HeadCarriesNoPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": {"StringLikeIfExists": {"s3:prefix": ["ENTITIES/${aws:PrincipalTag/cluster}/*", "ENTITIES/${aws:PrincipalTag/cluster}"]}}
    },
    {
      "Sid": "NeverDelete",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::BUCKET/*"
    },
    {
      "Sid": "NoSessionWithoutAClusterTag",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {"Null": {"aws:PrincipalTag/cluster": "true"}}
    }
  ]
}
