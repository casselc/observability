# Endpoints and keys the tests read, for the services ci/services.sh starts
# (SeaweedFS S3 on :18333 with otel/otelsecret, ClickHouse HTTP :18123 and
# TCP :19000). The workflows append this file to $GITHUB_ENV; locally:
#   set -a; . ci/test.env; set +a
AWS_ACCESS_KEY_ID=otel
AWS_SECRET_ACCESS_KEY=otelsecret
AWS_REGION=us-east-1
# parquetgo, parquetgo/compare, chdbexporter
CHDB_TEST_S3=http://127.0.0.1:18333/otel
CHDB_TEST_S3_KEY=otel
CHDB_TEST_S3_SECRET=otelsecret
CHDB_TEST_CLICKHOUSE=http://127.0.0.1:18123
# parquetgo/s3pqexporter
GOEDGE_S3=http://127.0.0.1:18333/goedge-test
# awss3/probe
INLINE_S3=http://127.0.0.1:18333
INLINE_CH=http://127.0.0.1:18123
# otap
OTAP_TEST_S3=http://127.0.0.1:18333/otel/otap
OTAP_TEST_S3_KEY=otel
OTAP_TEST_S3_SECRET=otelsecret
OTAP_TEST_CLICKHOUSE=http://127.0.0.1:18123
# bench (contrib clickhouseexporter comparison)
CLICKHOUSE_ENDPOINT=tcp://127.0.0.1:19000
# s3cas probe
S3CAS_ENDPOINT=http://127.0.0.1:18333
S3CAS_BUCKET=otel
S3CAS_REGION=us-east-1
S3CAS_KEY=otel
S3CAS_SECRET=otelsecret
# otap-rs consumer tests (their defaults, spelled out)
OTAPRS_CH=http://127.0.0.1:18123
OTAPRS_S3=http://127.0.0.1:18333/audit-consumer
# quint: the documented, verified backend for the Go model tests (see ci/README.md)
QUINTGO_BACKEND=typescript
