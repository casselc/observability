<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A small resident footprint on a laptop: workstation, non-concurrent GC (the Web SDK
         defaults to server GC, sized for a server's cores and memory). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <AssemblyName>oscope-forwarder</AssemblyName>
    <RootNamespace>Oscope.Forwarder.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- research/entra-ingress.md §4.1: MSAL.NET with the platform broker (4.73.1 or later for macOS) -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.90.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Oscope.Forwarder/Oscope.Forwarder.csproj" />
  </ItemGroup>
</Project>
