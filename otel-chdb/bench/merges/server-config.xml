<!-- The private instance used for these runs. SRV is its directory; start with
     clickhouse server --config-file=server-config.xml (after replacing SRV). -->
<clickhouse>
    <logger><level>information</level><log>SRV/server.log</log><errorlog>SRV/server.err.log</errorlog><size>100M</size><count>2</count></logger>
    <http_port>18623</http_port>
    <tcp_port>19600</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <path>SRV/data/</path>
    <tmp_path>SRV/data/tmp/</tmp_path>
    <user_files_path>SRV/data/user_files/</user_files_path>
    <mark_cache_size>268435456</mark_cache_size>
    <users>
        <default>
            <password/>
            <networks><ip>127.0.0.1</ip><ip>::1</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
    <profiles><default/></profiles>
    <quotas><default/></quotas>
    <!-- The only additions over the shared server's embedded config: the two logs
         this measurement attributes CPU from. Merge settings are all defaults. -->
    <part_log>
        <database>system</database><table>part_log</table>
        <flush_interval_milliseconds>2000</flush_interval_milliseconds>
    </part_log>
    <query_log>
        <database>system</database><table>query_log</table>
        <flush_interval_milliseconds>2000</flush_interval_milliseconds>
    </query_log>
    <storage_configuration>
        <disks>
            <cold_local><path>SRV/cold/</path></cold_local>
            <cold_s3>
                <type>s3</type>
                <endpoint>http://127.0.0.1:18333/otel/merges/s3disk/</endpoint>
                <access_key_id>otel</access_key_id>
                <secret_access_key>otelsecret</secret_access_key>
                <metadata_path>SRV/data/disks/cold_s3/</metadata_path>
            </cold_s3>
        </disks>
        <policies>
            <tiered_local><volumes><hot><disk>default</disk></hot><cold><disk>cold_local</disk></cold></volumes><move_factor>0</move_factor></tiered_local>
            <tiered_s3><volumes><hot><disk>default</disk></hot><cold><disk>cold_s3</disk></cold></volumes><move_factor>0</move_factor></tiered_s3>
        </policies>
    </storage_configuration>
</clickhouse>
