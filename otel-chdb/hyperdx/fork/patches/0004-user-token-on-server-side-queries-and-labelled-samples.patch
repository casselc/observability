@@ -0,0 +1,40 @@
+import { queryServiceAuth } from '@hyperdx/common-utils/dist/clickhouse/node';
+
+import { queryServiceUser } from '@/middleware/queryServiceUser';
+
+describe('queryServiceUser (otel-chdb fork)', () => {
+  const H = 'x-forwarded-access-token';
+  const run = (headers: Record<string, string>) =>
+    new Promise<ReturnType<typeof queryServiceAuth> | Error>(resolve => {
+      queryServiceUser(H)({ headers } as any, {} as any, () => {
+        // later, asynchronously, as a route handler or an MCP tool queries
+        setTimeout(() => {
+          try {
+            resolve(queryServiceAuth('/svc', () => 'service.token'));
+          } catch (e) {
+            resolve(e as Error);
+          }
+        }, 1);
+      });
+    });
+
+  it("gives the request's work the user's token", async () => {
+    expect(await run({ [H]: 'alice.jwt.sig' })).toEqual({
+      access_token: 'alice.jwt.sig',
+    });
+  });
+
+  it('fails a query started by a user without a token, never using the service identity', async () => {
+    const r = await run({});
+    expect(r).toBeInstanceOf(Error);
+    expect((r as Error).message).toMatch(/started by a user/);
+    const bad = await run({ [H]: 'two tokens' });
+    expect(bad).toBeInstanceOf(Error);
+  });
+
+  it('leaves work no request started to the service identity', () => {
+    expect(queryServiceAuth('/svc', () => 'service.token')).toEqual({
+      access_token: 'service.token',
+    });
+  });
+});
diff --git a/packages/api/src/middleware/queryServiceUser.ts b/packages/api/src/middleware/queryServiceUser.ts
