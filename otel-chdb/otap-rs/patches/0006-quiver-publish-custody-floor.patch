diff --git a/rust/otap-dataflow/crates/otap/src/custody.rs b/rust/otap-dataflow/crates/otap/src/custody.rs
new file mode 100644
index 0000000..c291f31
--- /dev/null
+++ b/rust/otap-dataflow/crates/otap/src/custody.rs
@@ -0,0 +1,86 @@
+//! The custody floor a durable buffer publishes for the exporter behind it.
+//!
+//! A durable buffer (Quiver) holds requests it has acknowledged to their
+//! senders and not yet had acknowledged downstream: its *custody*. An
+//! exporter that publishes to a reader who must know what is still in
+//! custody (for a completeness watermark) needs the oldest ingestion time
+//! among them. The buffer and the exporter of one pipeline run on the same
+//! thread (one single-threaded runtime per core), so the value is a
+//! thread-local: the buffer [`publish`]es it, the exporter reads it with
+//! [`current`].
+//!
+//! The published value is `min(the time it was computed, the ingestion time
+//! of every bundle still held)`, in nanoseconds since the Unix epoch. It is a
+//! lower bound for the ingestion time of everything in custody at any later
+//! moment as well: bundles only leave custody, and a bundle ingested later
+//! has a later ingestion time. `None`: nothing was published on this thread
+//! (no buffer, or not initialised yet).
+//!
+//! At shutdown the exporter may also need to know that the buffer's custody
+//! is empty (otel-chdb FORMAT.md §3.1, an orderly close): the buffer
+//! [`publish_drained`]s once its shutdown drain handed every bundle it held
+//! downstream, and counts the NACKs it handled ([`nack_handled`]); a NACK
+//! the exporter sends after the buffer stopped handling them leaves its
+//! bundle in custody, which the exporter sees as more NACKs sent than
+//! [`nacks_handled`].
+use std::cell::Cell;
+
+thread_local! {
+    static LOW: Cell<Option<u64>> = const { Cell::new(None) };
+    static DRAINED: Cell<bool> = const { Cell::new(false) };
+    static NACKS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// Publishes this thread's custody floor (ns since the Unix epoch).
+pub fn publish(low_ns: u64) {
+    LOW.with(|c| c.set(Some(low_ns)));
+}
+
+/// This thread's custody floor, if a durable buffer published one.
+#[must_use]
+pub fn current() -> Option<u64> {
+    LOW.with(Cell::get)
+}
+
+/// The buffer's shutdown drain handed every bundle it held downstream:
+/// nothing is left in its custody but what the exporter holds.
+pub fn publish_drained() {
+    DRAINED.with(|c| c.set(true));
+}
+
+/// Whether the buffer on this thread published [`publish_drained`].
+#[must_use]
+pub fn drained() -> bool {
+    DRAINED.with(Cell::get)
+}
+
+/// The buffer handled a NACK from downstream (its bundle is retried).
+pub fn nack_handled() {
+    NACKS.with(|c| c.set(c.get() + 1));
+}
+
+/// How many NACKs the buffer on this thread has handled.
+#[must_use]
+pub fn nacks_handled() -> u64 {
+    NACKS.with(Cell::get)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn publish_then_read_on_the_same_thread_only() {
+        assert_eq!(super::current(), None);
+        super::publish(42);
+        assert_eq!(super::current(), Some(42));
+        assert_eq!(std::thread::spawn(super::current).join().unwrap(), None);
+    }
+
+    #[test]
+    fn drained_and_nacks_are_per_thread() {
+        assert!(!super::drained());
+        super::nack_handled();
+        super::publish_drained();
+        assert!(super::drained() && super::nacks_handled() == 1);
+        assert!(!std::thread::spawn(super::drained).join().unwrap());
+    }
+}
