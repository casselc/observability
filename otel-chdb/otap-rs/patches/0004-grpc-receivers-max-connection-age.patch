+    #[test]
+    fn settings_validation() {
+        assert_eq!(ConnectionAge::from_settings(None, None), Ok(None));
+        assert!(ConnectionAge::from_settings(None, Some(Duration::from_secs(1))).is_err());
+        assert!(ConnectionAge::from_settings(Some(Duration::ZERO), None).is_err());
+        assert_eq!(
+            ConnectionAge::from_settings(
+                Some(Duration::from_secs(300)),
+                Some(Duration::from_secs(30))
