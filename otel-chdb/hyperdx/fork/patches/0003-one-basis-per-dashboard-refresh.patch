diff --git a/packages/api/src/utils/queryServiceToken.ts b/packages/api/src/utils/queryServiceToken.ts
index 8dba840..8154bec 100644
--- a/packages/api/src/utils/queryServiceToken.ts
+++ b/packages/api/src/utils/queryServiceToken.ts
@@ -19,3 +19,30 @@ export function queryServiceToken(
   if (!/^[A-Za-z0-9._~+/=-]+$/.test(token)) return undefined;
   return token;
 }
+
+const BASIS_RE = /^(latest|b1\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]{1,100})$/;
+const BASIS_GROUP_RE = /^[A-Za-z0-9_-]{8,64}$/;
+
+/**
+ * otel-chdb fork (D30): the basis headers the browser sent, for the query
+ * service's adapter: X-Otel-Basis (a basis token) and X-Otel-Basis-Group
+ * (one basis per dashboard refresh). Only single, well-formed values pass;
+ * anything else is dropped (the statement then reads up to now, and its
+ * answer says it was not at a basis).
+ */
+export function otelBasisHeaders(
+  headers: IncomingHttpHeaders,
+): Record<string, string> {
+  const out: Record<string, string> = {};
+  const one = (name: string, re: RegExp) => {
+    // eslint-disable-next-line security/detect-object-injection
+    const raw = headers[name];
+    if (typeof raw === 'string' && raw.length <= 16384 && re.test(raw)) {
+      // eslint-disable-next-line security/detect-object-injection
+      out[name] = raw;
+    }
+  };
+  one('x-otel-basis', BASIS_RE);
+  one('x-otel-basis-group', BASIS_GROUP_RE);
+  return out;
+}
