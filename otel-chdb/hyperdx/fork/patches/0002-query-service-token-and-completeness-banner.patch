+import React from 'react';
+import {
+  CompletenessStore,
+  getCompletenessStore,
+} from '@hyperdx/common-utils/dist/clickhouse/completeness';
+import { act, screen } from '@testing-library/react';
+
+import CompletenessBanner, {
+  completenessMessage,
+} from '@/components/CompletenessBanner';
+
+const lab = (completeness: any, t?: string, extra: object = {}) => ({
+  completeness,
+  completeThrough: t,
+  incompleteFrom: t,
+  receivedAt: 0,
+  ...extra,
+});
+
+describe('CompletenessBanner (otel-chdb fork)', () => {
+  it('says nothing only when there is no result', () => {
+    expect(completenessMessage(CompletenessStore.summarize([]))).toBeNull();
+  });
+
+  it('is never silent about a result that is not complete', () => {
+    for (const c of ['partial', 'unknown', 'unlabelled']) {
+      const m = completenessMessage(
+        CompletenessStore.summarize([
+          lab('complete', '2026-09-28T12:00:00Z'),
+          lab(c, '2026-09-28T11:00:00Z'),
+        ]),
+      );
+      expect(m?.title).not.toMatch(/^Complete/);
+      expect(m?.color).not.toBe('gray');
+    }
+  });
+
+  it('names the stale watermark', () => {
+    const m = completenessMessage(
+      CompletenessStore.summarize([
+        lab('unknown', '2026-09-28T11:00:00Z', {
+          watermarkStatus: 'stale',
+          watermarkNote: 'the watermark is stale',
+        }),
+      ]),
+    );
+    expect(m?.title).toBe('Unknown — watermark stale');
+    expect(m?.text).toContain('the watermark is stale');
+  });
+
+  it('follows the store', () => {
+    const store = getCompletenessStore();
+    store.reset();
+    renderWithMantine(<CompletenessBanner />);
+    expect(screen.queryByTestId('completeness-banner')).toBeNull();
+    act(() => store.record('q1', lab('complete', '2026-09-28T12:00:00Z')));
+    expect(screen.getByTestId('completeness-banner').dataset.completeness).toBe(
+      'complete',
+    );
+    act(() => store.record('q2', lab('partial', '2026-09-28T11:00:00Z')));
+    expect(screen.getByText('Partial')).toBeInTheDocument();
+    act(() => store.reset());
+    expect(screen.queryByTestId('completeness-banner')).toBeNull();
+  });
+});
