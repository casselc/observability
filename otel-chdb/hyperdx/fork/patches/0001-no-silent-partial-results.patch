diff --git a/packages/common-utils/src/core/overflow.ts b/packages/common-utils/src/core/overflow.ts
new file mode 100644
index 0000000..ddb8f49
--- /dev/null
+++ b/packages/common-utils/src/core/overflow.ts
@@ -0,0 +1,38 @@
+/**
+ * No partial results.
+ *
+ * ClickHouse's `*_overflow_mode` settings decide what happens when a query
+ * hits a limit (`max_execution_time`, `max_rows_to_read`,
+ * `max_rows_to_group_by`, `max_result_rows`, ...): `throw` fails the query;
+ * `break` (and `any` for GROUP BY) stops early and returns what it has with
+ * HTTP 200 and no marker. A short answer then reads as a complete one: a
+ * filter value that is missing reads as "no such value", a metric missing
+ * from the catalog as "not reported", a distribution as the real one, and an
+ * alert window as quiet.
+ *
+ * This fork pins every overflow mode to `throw` on every query the HyperDX
+ * client sends (`processClickhouseSettings`), after the call's own settings,
+ * so neither a call site nor a server or user profile can make a result
+ * partial. The limits themselves stay: a query that hits one fails, and the
+ * UI shows the error instead of a short answer. A source's `querySettings`
+ * go into the SQL `SETTINGS` clause, which ClickHouse applies over the HTTP
+ * parameters, so `joinQuerySettings` drops any overflow mode given there.
+ */
+export const NO_PARTIAL_RESULTS = {
+  timeout_overflow_mode: 'throw',
+  timeout_overflow_mode_leaf: 'throw',
+  read_overflow_mode: 'throw',
+  read_overflow_mode_leaf: 'throw',
+  result_overflow_mode: 'throw',
+  group_by_overflow_mode: 'throw',
+  set_overflow_mode: 'throw',
+  join_overflow_mode: 'throw',
+  sort_overflow_mode: 'throw',
+  distinct_overflow_mode: 'throw',
+  transfer_overflow_mode: 'throw',
+} as const;
+
+/** True for a setting that decides whether a limit truncates or fails. */
+export function isOverflowModeSetting(name: string): boolean {
+  return /_overflow_mode(_leaf)?$/i.test(name.trim());
+}
