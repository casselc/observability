{
  "listen": ":18190",
  "oidc": {
    "issuer": "https://idp.example.com/realms/observability",
    "audience": "otel-query",
    "algorithms": ["RS256"],
    "leeway_s": 30,
    "jwks_refresh_s": 300,
    "jwks_min_refresh_s": 30
  },
  "claims": {
    "subject": "sub",
    "clusters": "clusters",
    "namespaces": "namespaces",
    "roles": "roles",
    "groups": "groups",
    "group_grants": {
      "sre": {"clusters": ["*"], "namespaces": ["*"], "roles": ["query", "plan"]},
      "alertd-fleet": {"clusters": ["*"], "namespaces": ["*"], "roles": ["query"]},
      "team-shop": {"clusters": ["prod-eu-1", "prod-us-1"], "namespaces": ["shop", "cart"], "roles": ["query"]},
      "platform-eu": {"clusters": ["prod-eu-1"], "namespaces": ["*"], "roles": ["query", "plan"]}
    }
  },
  "audit": {"path": "/var/log/otel-query/audit.jsonl", "fsync": true},
  "central": {
    "url": "http://clickhouse:8123",
    "user": "otel_query_ro",
    "password_env": "QS_CH_PASSWORD",
    "database": "otel",
    "max_sql_bytes": 65536,
    "tables": [
      {"name": "otel_logs", "time_column": "Timestamp", "received_column": "received_at", "scope": "columns",
       "cluster_expr": "`__hdx_materialized_k8s.cluster.name`",
       "namespace_expr": "`__hdx_materialized_k8s.namespace.name`", "signals": ["logs"]},
      {"name": "otel_traces", "time_column": "Timestamp", "received_column": "received_at", "scope": "columns",
       "cluster_expr": "ResourceAttributes['k8s.cluster.name']",
       "namespace_expr": "ResourceAttributes['k8s.namespace.name']", "signals": ["traces"]},
      {"name": "otel_logs_kv_rollup_15m", "scope": "columns", "cluster_expr": "cluster", "signals": ["logs"]},
      {"name": "otel_traces_kv_rollup_15m", "scope": "columns", "cluster_expr": "cluster", "signals": ["traces"]},
      {"database": "entities", "name": "resource_kv", "scope": "columns", "cluster_expr": "cluster", "namespace_expr": "namespace"},
      {"name": "otel_metrics_series", "scope": "fleet", "signals": ["metrics_series"]},
      {"database": "system", "name": "tables", "scope": "metadata"},
      {"database": "system", "name": "columns", "scope": "metadata"},
      {"database": "system", "name": "data_skipping_indices", "scope": "metadata"},
      {"database": "system", "name": "settings", "scope": "metadata"},
      {"database": "system", "name": "table_engines", "scope": "metadata"},
      {"database": "system", "name": "databases", "scope": "metadata"}
    ],
    "dictionaries": [
      {"name": "entities.d_res",
       "attributes": {"pod_key": {"type": "UInt64", "default": "0", "ref": "entities.d_pod"},
                      "ct": {"type": "UInt8", "default": "0"}},
       "cluster_expr": "JSONExtractString(dictGet('entities.d_cluster', 'attrs', dictGet('entities.d_pod', 'cluster_key', dictGet('entities.d_res', 'pod_key', {key}))), 'k8s.cluster.name')",
       "namespace_expr": "JSONExtractString(dictGet('entities.d_ns', 'attrs', dictGet('entities.d_pod', 'ns_key', dictGet('entities.d_res', 'pod_key', {key}))), 'k8s.namespace.name')"},
      {"name": "entities.d_pod",
       "attributes": {"name": {"type": "String", "default": "''"},
                      "uid": {"type": "UUID", "default": "'00000000-0000-0000-0000-000000000000'"},
                      "start": {"type": "DateTime", "default": "0"},
                      "extra": {"type": "String", "default": "'{}'"},
                      "wl_key": {"type": "UInt64", "default": "0", "ref": "entities.d_wl"},
                      "node_key": {"type": "UInt64", "default": "0", "ref": "entities.d_node"},
                      "ns_key": {"type": "UInt64", "default": "0", "ref": "entities.d_ns"},
                      "cluster_key": {"type": "UInt64", "default": "0", "ref": "entities.d_cluster"}}},
      {"name": "entities.d_wl", "attributes": {"attrs": {"type": "String", "default": "'{}'"}, "containers": {"type": "String", "default": "'[]'"}}},
      {"name": "entities.d_node", "attributes": {"attrs": {"type": "String", "default": "'{}'"}}},
      {"name": "entities.d_ns", "attributes": {"attrs": {"type": "String", "default": "'{}'"}}},
      {"name": "entities.d_cluster", "attributes": {"attrs": {"type": "String", "default": "'{}'"}}}
    ],
    "performance_settings": {
      "query_plan_optimize_lazy_materialization": {"type": "bool", "why": "reads the columns of a top-N's winning rows only after the sort: fewer bytes read, the same rows (HyperDX sets it)"},
      "query_plan_max_limit_for_lazy_materialization": {"type": "uint", "min": 0, "max": 100000, "why": "the LIMIT up to which lazy materialization applies: a planning threshold, not a limit on the caller (HyperDX sets 100000)"},
      "use_skip_indexes_for_top_k": {"type": "bool", "why": "lets skip indexes prune granules for ORDER BY … LIMIT: the same top rows, fewer granules (HyperDX sets it)"},
      "query_plan_max_limit_for_top_k_optimization": {"type": "uint", "min": 0, "max": 100000, "why": "the LIMIT up to which the top-k optimization applies: a planning threshold (HyperDX sets 100000)"},
      "use_skip_indexes_on_data_read": {"type": "bool", "why": "applies skip indexes while reading instead of before: when granules are pruned, not which rows match (HyperDX sets it)"},
      "use_skip_indexes_for_disjunctions": {"type": "bool", "why": "lets skip indexes prune for OR conditions: pruning only drops granules no row of which matches (HyperDX sets it)"},
      "use_skip_indexes": {"type": "bool", "why": "skip indexes on or off: pruning never drops a matching row"},
      "enable_full_text_index": {"type": "bool", "why": "lets the text indexes be used to prune: the same rows (HyperDX sets it)"},
      "allow_calculating_subcolumns_sizes_for_merge_tree_reading": {"type": "bool", "why": "only reorders PREWHERE conditions by size (HyperDX sets 0: one S3 GET per map key on SharedMergeTree)"},
      "use_query_condition_cache": {"type": "bool", "why": "caches which granules a condition matched per part (exact, invalidated with the part): fewer granules read, never other rows; not the query result cache, which is forbidden"},
      "optimize_read_in_order": {"type": "bool", "why": "reads in sorting-key order for ORDER BY: the same result"},
      "optimize_aggregation_in_order": {"type": "bool", "why": "aggregates in sorting-key order for GROUP BY: the same result"},
      "optimize_move_to_prewhere": {"type": "bool", "why": "moves WHERE conditions to PREWHERE: the same rows, fewer bytes"},
      "move_all_conditions_to_prewhere": {"type": "bool", "why": "moves every WHERE condition to PREWHERE: the same rows"}
    }
  },
  "sample": {"default_rows": 3000000, "max_rows": 10000000},
  "limits": {
    "default": {"max_execution_time_s": 30, "max_rows_to_read": 2000000000, "max_bytes_to_read": 214748364800,
                "max_result_rows": 100000, "max_result_bytes": 67108864, "max_memory_usage": 4294967296, "max_concurrent": 4},
    "groups": {
      "sre": {"max_execution_time_s": 120, "max_concurrent": 8},
      "alert-evaluator": {"max_concurrent": 16}
    }
  },
  "catalog": {"database": "entities", "resources": "resources", "ingest_log": "ingest_log", "lag_max_s": 900},
  "s3": {"endpoint": "http://seaweedfs:8333", "public_endpoint": "https://lake.example.com", "region": "us-east-1", "bucket": "otel"},
  "lake_enabled": true,
  "lake": {"root": "edges", "url_ttl_s": 300, "replan_margin_s": 60, "max_objects": 2000, "max_heads": 2000,
           "skew_s": 300, "max_window_s": 86400},
  "watermark": {"cache_s": 15, "max_age_s": 300, "max_lateness_s": 60, "count_late": true},
  "basis": {"signer": "static", "keys_env": "QS_BASIS_KEYS", "retention_s": 7776000, "skew_s": 300},
  "cors_origins": ["https://lake-ui.example.com"],
  "max_body_bytes": 1048576
}
