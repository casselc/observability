index 0000000..8f4ef5e
--- /dev/null
+++ b/packages/common-utils/src/clickhouse/completeness.ts
@@ -0,0 +1,180 @@
+/**
+ * Completeness labels (otel-chdb fork).
+ *
+ * The fork's ClickHouse connection is the otel-chdb HyperDX adapter, which
+ * sends every statement to the query service and returns the service's label
+ * for the result in response headers:
+ *
+ *   X-Otel-Source            central | metadata
+ *   X-Otel-Completeness      complete | partial | unknown
+ *   X-Otel-Complete-Through  RFC 3339: every row before it is in central
+ *   X-Otel-Incomplete-From   RFC 3339: rows from here on may still arrive
+ *   X-Otel-Watermark-Status  ok | stale | missing | error
+ *   X-Otel-Watermark-Note    why completeness is unknown
+ *
+ * Every result the client receives is recorded here under its statement text
+ * (so a refreshed chart replaces its own label), and the app shows the worst
+ * label of the page in a banner. A result without a label is recorded as
+ * `unlabelled`: it did not come through the query service, so nothing says it
+ * is complete. Schema answers (`metadata`) are not recorded. Nothing is
+ * silent: no label is ever read as complete.
+ */
+import type { ResponseHeaders } from '@clickhouse/client-common';
+
+export type Completeness = 'complete' | 'partial' | 'unknown' | 'unlabelled';
+
+export type CompletenessLabel = {
+  completeness: Completeness;
+  /** Every row before this instant is in central (RFC 3339), if known. */
+  completeThrough?: string;
+  /** Rows from this instant on may still arrive (RFC 3339). */
+  incompleteFrom?: string;
+  watermarkStatus?: string;
+  watermarkNote?: string;
+  requestId?: string;
+  receivedAt: number;
+};
+
+const RANK: Record<Completeness, number> = {
+  complete: 0,
+  partial: 1,
+  unknown: 2,
+  unlabelled: 3,
+};
+
+function header(headers: ResponseHeaders | undefined, name: string) {
+  const v = headers?.[name.toLowerCase()];
+  return Array.isArray(v) ? v[0] : v;
+}
+
+/**
+ * The label a response carries; null for a schema answer (metadata), which
+ * says nothing about data completeness.
+ */
+export function labelFromHeaders(
+  headers: ResponseHeaders | undefined,
+  now: number = Date.now(),
+): CompletenessLabel | null {
+  const source = header(headers, 'x-otel-source');
+  if (source === 'metadata') {
+    return null;
+  }
+  const c = header(headers, 'x-otel-completeness');
+  if (source == null || c == null) {
+    return { completeness: 'unlabelled', receivedAt: now };
+  }
+  const completeness: Completeness =
+    c === 'complete' || c === 'partial' ? c : 'unknown';
+  return {
+    completeness,
+    completeThrough: header(headers, 'x-otel-complete-through') || undefined,
+    incompleteFrom: header(headers, 'x-otel-incomplete-from') || undefined,
+    watermarkStatus: header(headers, 'x-otel-watermark-status') || undefined,
+    watermarkNote: header(headers, 'x-otel-watermark-note') || undefined,
+    requestId: header(headers, 'x-otel-request-id') || undefined,
+    receivedAt: now,
+  };
+}
+
+export type CompletenessSummary = {
+  /** The worst label among the page's results; null when there are none. */
+  worst: Completeness | null;
+  /** The earliest complete_through among them. */
+  completeThrough?: string;
+  /** The earliest incomplete_from among them. */
+  incompleteFrom?: string;
+  watermarkStatus?: string;
+  watermarkNote?: string;
+  results: number;
+  counts: Record<Completeness, number>;
+};
+
+const MAX_ENTRIES = 500;
+
+function minTime(a: string | undefined, b: string | undefined) {
+  if (a == null) return b;
+  if (b == null) return a;
+  return Date.parse(a) <= Date.parse(b) ? a : b;
+}
+
+export class CompletenessStore {
+  private labels = new Map<string, CompletenessLabel>();
+  private listeners = new Set<() => void>();
+  private summary: CompletenessSummary = CompletenessStore.summarize([]);
+
+  record(key: string, label: CompletenessLabel | null) {
+    if (label == null) return;
+    this.labels.delete(key);
+    this.labels.set(key, label);
+    while (this.labels.size > MAX_ENTRIES) {
+      const oldest = this.labels.keys().next().value;
+      if (oldest === undefined) break;
+      this.labels.delete(oldest);
+    }
+    this.changed();
+  }
+
+  /** Forget every label (a new page). */
+  reset() {
+    if (this.labels.size === 0) return;
+    this.labels.clear();
+    this.changed();
+  }
+
+  subscribe = (fn: () => void) => {
+    this.listeners.add(fn);
+    return () => {
+      this.listeners.delete(fn);
+    };
+  };
+
+  getSummary = () => this.summary;
+
+  private changed() {
+    this.summary = CompletenessStore.summarize([...this.labels.values()]);
+    this.listeners.forEach(fn => fn());
+  }
+
+  static summarize(labels: CompletenessLabel[]): CompletenessSummary {
+    const counts: Record<Completeness, number> = {
+      complete: 0,
+      partial: 0,
+      unknown: 0,
+      unlabelled: 0,
+    };
+    const s: CompletenessSummary = {
+      worst: null,
+      results: labels.length,
+      counts,
+    };
+    for (const l of labels) {
+      counts[l.completeness]++;
+      if (s.worst == null || RANK[l.completeness] > RANK[s.worst]) {
+        s.worst = l.completeness;
+      }
+      s.completeThrough = minTime(s.completeThrough, l.completeThrough);
+      if (l.completeness !== 'complete') {
+        s.incompleteFrom = minTime(s.incompleteFrom, l.incompleteFrom);
+      }
+      if (l.watermarkStatus && l.watermarkStatus !== 'ok') {
+        s.watermarkStatus = l.watermarkStatus;
+        s.watermarkNote = l.watermarkNote;
+      }
+    }
+    return s;
+  }
+}
+
+const STORE_KEY = Symbol.for('otel-chdb.hyperdx.completeness');
+
+/**
+ * The process's (or the browser tab's) store. Kept on globalThis so that
+ * every bundled copy of this module shares one store.
+ */
+export function getCompletenessStore(): CompletenessStore {
+  const g = globalThis as unknown as Record<symbol, CompletenessStore>;
+  // eslint-disable-next-line security/detect-object-injection
+  g[STORE_KEY] ??= new CompletenessStore();
+  // eslint-disable-next-line security/detect-object-injection
+  return g[STORE_KEY];
+}
