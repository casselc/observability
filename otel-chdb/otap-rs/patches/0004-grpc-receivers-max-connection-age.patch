+    /// Scenario: the server is shut down while an RPC is in flight on a
+    /// connection with a max age.
+    /// Guarantees: shutdown waits for the RPC, which succeeds, as tonic's own
+    /// graceful shutdown does.
+    #[tokio::test]
+    async fn shutdown_waits_for_in_flight_rpcs() {
+        let server = start(
+            ConnectionAge::from_settings(Some(secs(60.0)), None).unwrap(),
+            secs(0.5),
