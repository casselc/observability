+        assert_eq!(age.jittered_with(0.0), Duration::from_secs(90));
+        assert_eq!(age.jittered_with(0.5), Duration::from_secs(100));
+        assert_eq!(age.jittered_with(1.0), Duration::from_secs(110));
+        let samples: Vec<Duration> = (0..1000).map(|_| age.jittered_age()).collect();
+        assert!(
+            samples
+                .iter()
+                .all(|d| *d >= Duration::from_secs(90) && *d < Duration::from_secs(110))
+        );
+        let below = samples
+            .iter()
+            .filter(|d| **d < Duration::from_secs(100))
+            .count();
+        assert!((350..=650).contains(&below), "skewed jitter: {below}/1000");
+    }
