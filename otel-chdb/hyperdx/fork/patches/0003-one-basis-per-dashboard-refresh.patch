-  /** Forget every label (a new page). */
+  /** Forget every label (a new page); the next pin is a new basis. */
   reset() {
+    this.pageNonce = nonce();
+    this.group = null;
     if (this.labels.size === 0) return;
     this.labels.clear();
     this.changed();
   }
 
+  /**
+   * Pin one basis for everything the page loads for this key (a dashboard's
+   * searched time range): the same key on the same page load is the same
+   * group (idempotent, so a re-render changes nothing); a new key, or a new
+   * page load, is a new group and so a new basis.
+   */
+  pinBasis(key: string) {
+    const g = `${this.pageNonce}-${key}`
+      .replace(/[^A-Za-z0-9_-]/g, '')
+      .slice(0, 64);
+    this.group = GROUP_RE.test(g) ? g : null;
+  }
+
+  /** Stop pinning: statements read up to now (and say so). */
+  unpinBasis() {
+    this.group = null;
+  }
+
+  /** The headers every statement carries while a basis is pinned. */
+  basisHeaders(): Record<string, string> {
+    return this.group ? { 'x-otel-basis-group': this.group } : {};
+  }
