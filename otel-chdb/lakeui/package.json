{
  "name": "otel-chdb-lakeui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The lake-first UI, first slice: /v1/plan, hyparquet range reads, completeness on every view",
  "scripts": {
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/trace-reporter.js --test-reporter-destination=stderr test/*.test.js",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "e2e": "playwright test -c e2e/playwright.config.mjs",
    "journeys": "playwright test -c e2e/journeys/playwright.config.mjs",
    "journeys:render": "e2e/journeys/render.sh"
  },
  "dependencies": {
    "hyparquet": "1.31.2",
    "fzstd": "0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "fast-check": "4.10.2"
  }
}
